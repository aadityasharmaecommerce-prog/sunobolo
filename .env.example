# ─────────────────────────────────────────────────────────────
# SunoBolo English — Environment variables
# Phase 1 (frontend only): everything runs on mock/local data.
# Phase 2 (backend): set USE_REMOTE_API=true and VITE_API_URL to
# point at the Cloudflare Worker URL. No frontend code changes
# are needed — the service layer reads these values.
# ─────────────────────────────────────────────────────────────

# Set to "true" to switch all services from mock data to the Cloudflare Worker API
VITE_USE_REMOTE_API=false

# Cloudflare Worker base URL (Phase 2, e.g. https://api.sunobolo.com)
VITE_API_URL=

# Admin API token (Phase 2, passed as Bearer token to admin endpoints)
VITE_ADMIN_TOKEN=
