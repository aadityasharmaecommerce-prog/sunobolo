{
  "name": "sunobolo-english",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:client": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name sunobolo-english --commit-dirty=true",
    "db:migrate:local": "wrangler d1 migrations apply sunobolo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sunobolo-db --remote",
    "db:seed:remote": "wrangler d1 execute sunobolo-db --remote --file=./migrations/0002_seed.sql",
    "db:seed:local": "wrangler d1 execute sunobolo-db --local --file=./migrations/0002_seed.sql",
    "db:create": "wrangler d1 create sunobolo-db",
    "audio:gen": "python3 scripts/sarvam_replace_all.py",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:build:aab": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:install": "cd android && ./gradlew installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/native-purchases": "^8.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.32.0",
    "node-forge": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
